# ==============================================================================
# FILE MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG (.env.example) - ĐỀ 19: WEBSITE TIN TỨC
# Sao chép file này thành .env và thay đổi mật khẩu trước khi chạy:
# cp .env.example .env
# ==============================================================================

# --- 1. CẤU HÌNH CƠ SỞ DỮ LIỆU MYSQL 8.0 ---
MYSQL_ROOT_PASSWORD=ChangeMe#Root$2026!SecDb99
MYSQL_DATABASE=vietnews_db
MYSQL_USER=wp_news_user
MYSQL_PASSWORD=ChangeMe#App$2026!WpUsr88

# Tài khoản riêng chỉ đọc metrics cho Prometheus MySQL Exporter (Least Privilege)
MYSQL_EXPORTER_USER=exporter_user
MYSQL_EXPORTER_PASSWORD=ChangeMe#Exp$2026!Metric77

# --- 2. CẤU HÌNH WEBSITE TIN TỨC WORDPRESS ---
WP_TABLE_PREFIX=vn24_
WP_SITE_URL=https://localhost
WP_SITE_TITLE=VietNews 24h - Cổng Thông Tin Điện Tử Tổng Hợp
WP_ADMIN_USER=admin_vietnews
WP_ADMIN_PASSWORD=ChangeMe#Admin$2026!Portal66
WP_ADMIN_EMAIL=banbientap@vietnews24h.local
WP_EDITOR_USER=bientapvien
WP_EDITOR_PASSWORD=ChangeMe#Editor$2026!News55
WP_EDITOR_EMAIL=bientap@vietnews24h.local

# --- 3. CẤU HÌNH QUẢN TRỊ GRAFANA MONITORING ---
GF_SECURITY_ADMIN_USER=admin_monitor
GF_SECURITY_ADMIN_PASSWORD=ChangeMe#Grafana$2026!Mon44

# --- 4. CỔNG TRUY CẬP DỊCH VỤ ---
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
PHPMYADMIN_PORT=8081
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
CADVISOR_PORT=8082
