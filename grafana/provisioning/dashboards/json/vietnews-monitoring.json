      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum by (id) (rate(container_cpu_usage_seconds_total{id=~\"/docker/.*|/system.slice/docker-.*\"}[1m])) * 100",
