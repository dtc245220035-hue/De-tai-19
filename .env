# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG - ĐỀ 19: WEBSITE TIN TỨC / CỔNG THÔNG TIN (VIETNEWS 24H)
# Áp dụng chính sách mật khẩu mạnh (Hardening: Strong Password Policy >= 16 ký tự)
# ==============================================================================

# --- 1. CẤU HÌNH CƠ SỞ DỮ LIỆU MYSQL 8.0 ---
MYSQL_ROOT_PASSWORD=Admin@123
MYSQL_DATABASE=vietnews_db
MYSQL_USER=wp_news_user
MYSQL_PASSWORD=Admin@123

# Tài khoản riêng chỉ đọc metrics cho Prometheus MySQL Exporter (Least Privilege)
MYSQL_EXPORTER_USER=exporter_user
MYSQL_EXPORTER_PASSWORD=Admin@123

# --- 2. CẤU HÌNH WEBSITE TIN TỨC WORDPRESS ---
WP_TABLE_PREFIX=vn24_
WP_SITE_URL=https://localhost
WP_SITE_TITLE=VietNews 24h - Cổng Thông Tin Điện Tử Tổng Hợp
WP_ADMIN_USER=admin_vietnews
WP_ADMIN_PASSWORD=Admin@123
WP_ADMIN_EMAIL=banbientap@vietnews24h.local
WP_EDITOR_USER=bientapvien
WP_EDITOR_PASSWORD=Admin@123
WP_EDITOR_EMAIL=bientap@vietnews24h.local

# --- 3. CẤU HÌNH QUẢN TRỊ GRAFANA MONITORING ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=Admin@123

# --- 4. CỔNG TRUY CẬP DỊCH VỤ (CHỈ BIND LOOPBACK CHO DỊCH VỤ QUẢN TRỊ) ---
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
PHPMYADMIN_PORT=8081
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
CADVISOR_PORT=8082
